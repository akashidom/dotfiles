{
  "$schema": "https://opencode.ai/config.json",
  // Note: Do not add models that don't support tools. Last updated: 2026-08-27.
  // Gemma models (gemma3:1b, gemma4:31b-cloud) do not support tools and are commented out.
  // Using cloud-only models as local performance is inadequate on current hardware.
  "model": "ollama/nemotron-3-super:cloud",
  "small_model": "ollama/gpt-oss:20b-cloud",
  "lsp": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama3.2:3b": {
          "id": "llama3.2:3b",
          "name": "Llama 3.2 3B"
        },
        "nemotron-3-ultra:cloud": {
          "id": "nemotron-3-ultra:cloud",
          "name": "Nemotron 3 Ultra Cloud"
        },
        "nemotron-3-super:cloud": {
          "id": "nemotron-3-super:cloud",
          "name": "Nemotron 3 Super Cloud"
        },
        "nemotron-3-nano:30b-cloud": {
          "id": "nemotron-3-nano:30b-cloud",
          "name": "Nemotron 3 Nano 30B Cloud"
        },
        "gemma4:31b-cloud": {
          "id": "gemma4:31b-cloud",
          "name": "Gemma 4 31B Cloud"
        },
        "gpt-oss:20b-cloud": {
          "id": "gpt-oss:20b-cloud",
          "name": "GPT OSS 20B Cloud"
        },
        "gpt-oss:120b-cloud": {
          "id": "gpt-oss:120b-cloud",
          "name": "GPT OSS 120B Cloud"
        },
        "qwen3:0.6b": {
          "id": "qwen3:0.6b",
          "name": "Qwen 3 0.6B"
        },
        "qwen2.5-coder:3b": {
          "id": "qwen2.5-coder:3b",
          "name": "Qwen 2.5 Coder 3B"
        },
        "llama3.2:1b": {
          "id": "llama3.2:1b",
          "name": "Llama 3.2 1B"
        },
        "qwen3:1.7b": {
          "id": "qwen3:1.7b",
          "name": "Qwen 3 1.7B"
        },
        "gemma3:1b": {
          "id": "gemma3:1b",
          "name": "Gemma 3 1B"
        },
        "qwen3:4b": {
          "id": "qwen3:4b",
          "name": "Qwen 3 4B"
        },
        "qwen3:8b": {
          "id": "qwen3:8b",
          "name": "Qwen 3 8B"
        },
        "minimax-m3:cloud": {
          "id": "minimax-m3:cloud",
          "name": "MiniMax M3 Cloud"
        }
      }
    }
  },
  // User requested configuration changes:
   "username": "qasha",
  "shell": "/bin/bash",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
    "instructions": ["USER.md", "AGENTS.md"],
  "formatter": true,
  "lsp": true,
  "experimental": {
    "batch_tool": false
  },
  "permission": {
    "external_directory": {
      "/mnt/config/qasha/**": "allow",
      "/etc/**": "allow",
      "/home/qasha/.config/**": "allow",
      "*": "ask"
    }
  }
}